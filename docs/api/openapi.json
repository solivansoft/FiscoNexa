  "components": {
    "securitySchemes": {
      "TokenTenant": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de integração da empresa; escopo documents:read."
      },
      "ChaveERP": {
        "type": "http",
        "scheme": "bearer",
        "description": "Chave bootstrap ERP com escopo da operação."
      }
    },
    "schemas": {
      "Empresa": {
        "type": "object",
        "properties": {
          "id_empresa": {
            "type": "string",
            "format": "uuid"
          },
          "id_integracao": {
            "type": "string",
            "format": "uuid"
          },
          "repetido": {
            "type": "boolean"
          },
          "uf": {
            "type": "string"
          },
          "razao_social": {
            "type": "string"
          },
          "nome_fantasia": {
            "type": "string"
          },
          "cadastro_disponivel": {
            "type": "boolean"
          },
          "dados_cadastrais": {
            "type": "object",
            "additionalProperties": true
          },
          "token_integracao": {
            "type": "string",
            "description": "Retornado somente na primeira criação; guardar de forma protegida por empresa."
          }
        },
        "required": [
          "id_empresa",
          "id_integracao",
          "repetido",
          "uf",
          "razao_social",
          "nome_fantasia",
          "cadastro_disponivel"
        ]
      },
      "Documento": {
        "type": "object",
        "properties": {
          "nsu": {
            "type": "integer",
            "format": "int64"
          },
          "id_documento": {
            "type": "string",
            "format": "uuid"
          },
          "chave_acesso": {
            "type": "string",
            "pattern": "^[0-9]{44}$"
          },
          "tipo_documento": {
            "type": "string",
            "example": "NFe"
          },
          "modelo": {
            "type": "string",
            "example": "55"
          },
          "serie": {
            "type": "string",
