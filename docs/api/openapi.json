  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Infraestrutura"
        ],
        "summary": "Verificar disponibilidade",
        "description": "Verificar disponibilidade",
        "operationId": "get_health",
        "security": [],
        "responses": {
          "200": {
            "description": "API disponível.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "situacao": {
                      "type": "string",
                      "enum": [
                        "disponivel"
                      ]
                    }
                  },
                  "required": [
                    "situacao"
                  ]
                },
                "example": {
                  "situacao": "disponivel"
                }
              }
            }
          }
        }
      }
    },
    "/v1/empresas": {
      "post": {
        "tags": [
          "Empresas"
        ],
        "summary": "Cadastrar e ativar empresa",
        "description": "Requer a chave de integração com escopo companies:onboard. A API identifica o CNPJ pelo certificado e complementa os dados cadastrais. Informe uf se a API retornar uf_obrigatoria. Guarde token_integracao no primeiro cadastro.",
        "operationId": "post_v1_empresas",
        "security": [
          {
            "ChaveERP": []
          }
        ],
        "responses": {
          "201": {
            "description": "Empresa ativada; guarde token_integracao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Empresa"
                }
              }
            }
          },
          "200": {
            "description": "Cadastro repetido; sem reemitir token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Empresa"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente ou inválida; corpo pode ser vazio."
          },
          "422": {
            "description": "Dados inválidos."
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 120
            },
            "description": "Chave persistida por operação. Reutilize após timeout.",
            "example": "erp-operacao-00000001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uf": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  },
                  "certificado_a1_base64": {
                    "type": "string",
                    "format": "byte"
                  },
                  "senha_certificado_base64": {
                    "type": "string",
                    "format": "byte"
                  }
                },
                "required": [
                  "certificado_a1_base64",
                  "senha_certificado_base64"
                ]
              },
              "example": {
                "uf": "PA",
                "certificado_a1_base64": "ZXhlbXBsby1uYW8tZS1jZXJ0aWZpY2Fkbw==",
                "senha_certificado_base64": "ZXhlbXBsby1zZW5oYQ=="
              }
            }
          }
        }
      }
    },
    "/v1/empresas/{id_empresa}/modulos/monitoramento": {
      "put": {
        "tags": [
          "Monitoramento"
        ],
        "summary": "Alterar situação do modulo",
        "description": "Requer modules:write e empresa vinculada ao ERP da chave.",
        "operationId": "put_v1_empresas_id_empresa_modulos_monitoramento",
        "security": [
          {
            "ChaveERP": []
          }
        ],
        "responses": {
          "200": {
            "description": "Modulo atualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "situacao": {
                      "type": "string",
                      "enum": [
                        "atualizada"
                      ]
                    }
                  },
                  "required": [
                    "situacao"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente ou inválida; corpo pode ser vazio."
          },
          "404": {
            "description": "Recurso não encontrado ou fora do tenant."
          }
        },
        "parameters": [
          {
            "name": "id_empresa",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "situacao": {
                    "type": "string",
                    "enum": [
                      "ativo",
                      "suspenso",
                      "cancelado"
                    ]
                  }
                },
                "required": [
                  "situacao"
                ]
              },
              "example": {
                "situacao": "suspenso"
              }
            }
          }
        }
      }
    },
    "/v1/monitoramento": {
      "get": {
        "tags": [
          "Monitoramento"
        ],
        "summary": "Consultar monitoramento",
        "description": "Consultar monitoramento",
        "operationId": "get_v1_monitoramento",
        "security": [
          {
            "TokenTenant": []
          }
        ],
        "responses": {
          "200": {
            "description": "Estado persistido do worker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Monitoramento"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente ou inválida; corpo pode ser vazio."
          },
          "403": {
            "description": "Sem permissão."
          },
          "404": {
            "description": "Recurso não encontrado ou fora do tenant."
          }
        }
      }
    },
    "/v1/documentos": {
      "get": {
        "tags": [
          "Documentos"
        ],
        "summary": "Sincronizar documentos",
        "description": "Persista ultimo_nsu após processar toda a página. O valor_total e texto decimal em reais. Consulta não dispara monitoramento SEFAZ.",
        "operationId": "get_v1_documentos",
        "security": [
          {
            "TokenTenant": []
          }
        ],
        "responses": {
          "200": {
            "description": "Página de documentos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Documentos"
                },
                "example": {
                  "itens": [],
                  "ultimo_nsu": 0
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos."
          },
          "401": {
            "description": "Credencial ausente ou inválida; corpo pode ser vazio."
          },
          "402": {
            "description": "Licenca ou assinatura restrita."
          },
          "403": {
            "description": "Sem permissão."
          }
        },
        "parameters": [
          {
            "name": "nsu",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "format": "int64"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 500
            }
          }
        ]
      }
    },
    "/v1/documentos/{id_documento}/xml": {
      "get": {
        "tags": [
          "Documentos"
        ],
        "summary": "Baixar ou solicitar XML",
        "description": "200 entrega o XML. 202 informa processamento pendente; aguarde antes de consultar novamente. 409 informa uma restrição fiscal conhecida, detalhada em motivo e ciencia_cstat.",
        "operationId": "get_v1_documentos_id_documento_xml",
        "security": [
          {
            "TokenTenant": []
          }
        ],
        "responses": {
          "200": {
            "description": "Conteúdo XML.",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "202": {
            "description": "Aguardando processamento.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "situacao": {
                      "type": "string",
                      "enum": [
                        "pendente"
                      ]
                    },
                    "id_comando": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "situacao",
                    "id_comando"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Indisponibilidade fiscal conhecida.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "situacao": {
                      "type": "string",
                      "enum": [
                        "indisponivel"
                      ]
                    },
                    "motivo": {
                      "type": "string",
                      "enum": [
                        "prazo_ciencia_encerrado",
                        "manifestacao_final_existente",
                        "ciencia_recusada"
                      ]
                    },
                    "ciencia_cstat": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "situacao",
                    "motivo",
                    "ciencia_cstat"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente ou inválida; corpo pode ser vazio."
          },
          "402": {
            "description": "Licenca ou assinatura restrita."
          },
          "403": {
            "description": "Sem permissão."
          },
          "404": {
            "description": "Recurso não encontrado ou fora do tenant."
          }
        },
        "parameters": [
          {
            "name": "id_documento",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
