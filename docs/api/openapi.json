        "operationId": "post_v1_cobrancas",
        "security": [
          {
            "TokenTenant": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cobrança e assinatura atualizadas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cobranca"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente ou inválida; corpo pode ser vazio."
          },
          "403": {
            "description": "Sem permissão."
          },
          "404": {
            "description": "Recurso não encontrado ou fora do tenant."
          },
          "409": {
            "description": "Conflito; consulte a situação atual."
          },
          "422": {
            "description": "Dados inválidos."
          },
          "503": {
            "description": "Provedor temporariamente indisponível."
          },
          "500": {
            "description": "Falha interna."
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 120
            },
            "description": "Chave persistida por operação. Reutilize após timeout.",
            "example": "erp-operacao-00000001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "plano_codigo": {
                    "type": "string",
                    "enum": [
                      "mensal",
                      "trimestral",
                      "anual"
                    ]
                  }
                },
                "required": [
                  "plano_codigo"
                ]
              },
              "example": {
                "plano_codigo": "mensal"
              }
            }
          }
        }
      }
    },
