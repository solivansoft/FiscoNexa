    "/v1/planos": {
      "get": {
        "tags": [
          "Assinaturas"
        ],
        "summary": "Consultar planos e preços",
        "description": "Consulte os planos vigentes da FiscoNexa. Os valores retornados são calculados pelo serviço; a integradora não informa valores ao criar uma cobrança.",
        "operationId": "get_v1_planos",
        "security": [
          {
            "TokenTenant": []
          }
        ],
        "responses": {
          "200": {
            "description": "Preços atuais calculados no servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Planos"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente ou inválida; corpo pode ser vazio."
          },
          "403": {
            "description": "Sem permissão."
          },
          "500": {
            "description": "Falha interna."
          }
        }
