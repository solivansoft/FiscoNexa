[Unit]
Description=FiscoNexa API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=fisconexa
Group=fisconexa
WorkingDirectory=/opt/fisconexa/current
EnvironmentFile=/etc/fisconexa/fisconexa.env
EnvironmentFile=-/etc/fisconexa/version.env
Environment=TZ=UTC
Environment=LD_LIBRARY_PATH=/opt/fisconexa/current/lib
Environment=OPENSSL_MODULES=/opt/fisconexa/current/lib/ossl-modules
Environment=FISCONEXA_LOG_DIR=/var/log/fisconexa
Environment=FISCONEXA_INSTANCE_ID=%H-api
ExecStart=/opt/fisconexa/current/FiscoNexa.Api
Restart=always
RestartSec=10s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fisconexa-api
NoNewPrivileges=true
PrivateTmp=true
# O grupo fisconexa inclui somente o coletor Alloy; permite leitura dos logs.
UMask=0027

[Install]
WantedBy=multi-user.target
