[Unit]
Description=FiscoNexa conciliacao de pagamentos Asaas
Wants=network-online.target
After=network-online.target fisconexa-api.service

[Service]
Type=oneshot
User=fisconexa
Group=fisconexa
WorkingDirectory=/opt/fisconexa/current
EnvironmentFile=/etc/fisconexa/fisconexa.env
EnvironmentFile=-/etc/fisconexa/asaas.env
EnvironmentFile=-/etc/fisconexa/version.env
Environment=TZ=UTC
Environment=LD_LIBRARY_PATH=/opt/fisconexa/current/lib
Environment=OPENSSL_MODULES=/opt/fisconexa/current/lib/ossl-modules
Environment=FISCONEXA_LOG_DIR=/var/log/fisconexa
Environment=FISCONEXA_INSTANCE_ID=%H-cobrancas
ExecStart=/opt/fisconexa/current/FiscoNexa.Api --reconciliar-cobrancas
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
