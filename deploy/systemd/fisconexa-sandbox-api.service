[Unit]
Description=FiscoNexa API de homologacao Asaas
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=fisconexa-sandbox
Group=fisconexa-sandbox
WorkingDirectory=/opt/fisconexa-sandbox/current
EnvironmentFile=/etc/fisconexa-sandbox/app.env
EnvironmentFile=/etc/fisconexa-sandbox/asaas.env
Environment=TZ=UTC
Environment=FISCONEXA_HTTP_HOST=127.0.0.1
Environment=FISCONEXA_HTTP_PORT=9001
Environment=FISCONEXA_ENVIRONMENT=homologacao
Environment=LD_LIBRARY_PATH=/opt/fisconexa-sandbox/current/lib
Environment=OPENSSL_MODULES=/opt/fisconexa-sandbox/current/lib/ossl-modules
Environment=FISCONEXA_LOG_DIR=/var/log/fisconexa-sandbox
Environment=FISCONEXA_INSTANCE_ID=%H-sandbox-api
ExecStart=/opt/fisconexa-sandbox/current/FiscoNexa.Api
Restart=always
RestartSec=10s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/fisconexa-sandbox
UMask=0027

[Install]
WantedBy=multi-user.target
