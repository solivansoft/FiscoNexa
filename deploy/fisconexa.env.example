FISCONEXA_DB_HOST=127.0.0.1
FISCONEXA_DB_PORT=5432
FISCONEXA_DB_NAME=fisconexa
FISCONEXA_DB_USER=fisconexa
FISCONEXA_DB_PASSWORD=
FISCONEXA_SEFAZ_MODE=acbr
FISCONEXA_AUTO_AWARENESS=true
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FISCONEXA_KMS_KEY_ID=
S3_XML_BUCKET=
FISCONEXA_LICENSE_TOKEN_SHA256=
FISCONEXA_ENVIRONMENT=producao
FISCONEXA_LOG_CONSOLE=true
FISCONEXA_HTTP_HOST=127.0.0.1
FISCONEXA_HTTP_PORT=9000

# Credenciais opcionais de cobranca em /etc/fisconexa/asaas.env, fora do Git.
# ASAAS_AMBIENTE=producao (sandbox somente em ambiente de homologacao)
# ASAAS_API_TOKEN=
# ASAAS_WEBHOOK_TOKEN=segredo independente com pelo menos 32 caracteres
