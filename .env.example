# Exclusivamente para desenvolvimento local. Copie para .env antes de subir o Docker.
POSTGRES_DB=fisconexa_dev
POSTGRES_USER=fisconexa
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_PORT=5432

# AWS S3. Nunca versione o arquivo .env real.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
FISCONEXA_KMS_KEY_ID=
S3_XML_BUCKET=

# Somente para a primeira consulta homologada; producao deve manter true.
FISCONEXA_AUTO_AWARENESS=true

# Opcional no Windows: runtime OpenSSL 3 que contenha bin\libcrypto-3-x64.dll,
# bin\libssl-3-x64.dll e lib\ossl-modules\legacy.dll. O build do worker copia
# esses arquivos para a distribuicao, sem dependencia em tempo de execucao.
FISCONEXA_OPENSSL_RUNTIME_DIR=

# Credenciais normais de um superadmin, usadas somente pelo smoke vertical
# para obter chave ERP pela propria API. Nunca versione o .env real.
FISCONEXA_ADMIN_EMAIL=
FISCONEXA_ADMIN_PASSWORD=
